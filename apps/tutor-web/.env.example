# Copy to apps/tutor-web/.env.local. The defaults work with the Firebase emulators.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ceeq
NEXT_PUBLIC_FIREBASE_API_KEY=
# Needed only for the live project (phone sign-in); the emulators ignore them.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to false to use the live project (functions, sign-in and database) instead of the local emulators.
NEXT_PUBLIC_USE_FUNCTIONS_EMULATOR=true
