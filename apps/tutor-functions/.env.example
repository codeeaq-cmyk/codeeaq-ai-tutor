# Copy to apps/tutor-functions/.env to override the defaults (all optional).
# Text models that compile syllabi for boards/classes without curated data, tried in order.
GEMINI_SYLLABUS_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Text models that split chapters into modules and write quizzes, fastest first.
GEMINI_COURSE_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash
# Voice model and voice for lessons.
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE=Sulafat
